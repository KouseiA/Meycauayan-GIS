# =============================================================
# Meycauayan GIS Portal — Production Environment Variables
# =============================================================
# Copy this file to your hosting provider's environment config.
#
# On shared hosting (cPanel):
#   1. Go to cPanel → Software → Select PHP Version → Environment Variables
#   2. Or add to .htaccess:
#      SetEnv GIS_ENV production
#      SetEnv GIS_DB_HOST localhost
#      SetEnv GIS_DB_USER cpuser_gisadmin
#      SetEnv GIS_DB_PASS YourStrongPassword
#      SetEnv GIS_DB_NAME cpuser_meycauayan_gis
#      SetEnv GIS_CORS_ORIGIN https://yourdomain.ph
#
# On VPS (Linux):
#   Add to /etc/apache2/sites-available/yourdomain.conf:
#      SetEnv GIS_ENV production
#      SetEnv GIS_DB_HOST localhost
#      ... etc.
# =============================================================

GIS_ENV=production
GIS_DB_HOST=localhost
GIS_DB_USER=your_db_user
GIS_DB_PASS=your_strong_password_here
GIS_DB_NAME=your_database_name
GIS_CORS_ORIGIN=https://yourdomain.ph
